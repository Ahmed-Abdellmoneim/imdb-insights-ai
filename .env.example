# Copy to .env and fill in. Never commit .env.

# API keys for the ingestion pipeline.
OMDB_API_KEY=
TMDB_API_KEY=

# Optional: publish to / read from a PRIVATE Hugging Face dataset (e.g. your-name/imdb-insights-data).
# Use a write token for publishing; the deployed app only needs a read token.
HF_DATASET_REPO=
HF_TOKEN=

# Assistant LLM: any OpenAI-compatible endpoint. The default is Groq's free tier
# (create a key at https://console.groq.com, no payment details needed).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
