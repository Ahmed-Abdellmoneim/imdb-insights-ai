# Copy to .env and fill in. Never commit .env.

# API keys for the ingestion pipeline.
OMDB_API_KEY=
TMDB_API_KEY=

# Optional: publish to / read from a PRIVATE Hugging Face dataset (e.g. your-name/imdb-insights-data).
# Use a write token for publishing; the deployed app only needs a read token.
HF_DATASET_REPO=
HF_TOKEN=
